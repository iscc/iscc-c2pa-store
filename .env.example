# ISCC C2PA Store configuration. Copy to .env for local development; set as environment variables in deployment.

# Required.
DJANGO_SECRET_KEY=change-me
# Public base URL; manifest addresses, the did:web identifier (did:web:<host>) and the host check derive from it.
ISCC_C2PA_STORE_URL=http://127.0.0.1:45470
# DJANGO_DEBUG=false
# Host names the store answers to (default: the host of ISCC_C2PA_STORE_URL); localhost and 127.0.0.1 are always added.
# DJANGO_ALLOWED_HOSTS=

# Storage: SQLite and the manifest files under the data directory, or a database URL.
# ISCC_C2PA_STORE_DATA_DIR=./data
# DATABASE_URL=postgres://user:password@host:5432/store

# PEM file of trust anchors for signing credentials (default: the bundled C2PA trust list).
# ISCC_C2PA_STORE_TRUST_ANCHORS=

# Declarations. A secret key and a hub URL enable them; without both the store hosts and finds manifests only.
# Create a key once per instance with `uvx iscc-crypto keygen` and keep the secret key secret.
# ISCC_C2PA_STORE_SECKEY=z3u2...
# ISCC_C2PA_STORE_HUB_URL=https://staging.iscc.id
# ISCC_C2PA_STORE_HUB_ID=1
# ISCC_C2PA_STORE_HUB_TIMEOUT=5.0
# ISCC_C2PA_STORE_DECLARE_DEFAULT=true

# Operator token for DELETE /v1/manifests/{id}: the SHA-256 hex digest of the token, never the token itself.
# Create one with: uv run python scripts/operator_token.py
# ISCC_C2PA_STORE_OPERATOR_TOKEN_SHA256=

# Limits (defaults shown): requests per client (IPv4 address or IPv6 /64) and period, operator login attempts,
# upload cap in bytes, lowest reported similarity score (the lowest score iscc-c2pa-resolver reports).
# ISCC_C2PA_STORE_RATE_WRITE=10/m
# ISCC_C2PA_STORE_RATE_READ=120/m
# ISCC_C2PA_STORE_RATE_LOGIN=10/m
# ISCC_C2PA_STORE_MAX_UPLOAD=2097152
# ISCC_C2PA_STORE_MATCH_THRESHOLD=75
# Comma-separated client addresses without rate limits: the public addresses of your own resolvers, which fetch
# manifests for all their users.
# ISCC_C2PA_STORE_UNTHROTTLED=
# Reverse proxies in front of the store that append to X-Forwarded-For (1 behind Caddy).
# ISCC_C2PA_STORE_NUM_PROXIES=0

# Container only (docker/entrypoint.sh): seconds between declaration retry rounds, and the gunicorn options, which
# replace the image's defaults (keep --bind 0.0.0.0:8000).
# ISCC_C2PA_STORE_RETRY_SECONDS=120
# GUNICORN_CMD_ARGS=--bind 0.0.0.0:8000 --workers 1 --threads 8 --timeout 30 --access-logfile -
